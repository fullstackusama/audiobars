{
  "name": "audiobars",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-dependency 60 FPS HTML5 Canvas audio spectrum visualization micro-library.",
  "main": "./dist/audiobars.umd.js",
  "module": "./dist/audiobars.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/audiobars.mjs",
      "require": "./dist/audiobars.umd.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --mode library",
    "preview": "vite preview"
  },
  "keywords": [
    "audiobars",
    "audio-visualizer",
    "spectrum-analyzer",
    "canvas",
    "waveform",
    "web-audio-api",
    "react",
    "nextjs",
    "zero-dependency"
  ],
  "author": "fullstackusama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstackusama/audiobars.git"
  },
  "bugs": {
    "url": "https://github.com/fullstackusama/audiobars/issues"
  },
  "homepage": "https://audiobars.vercel.app",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
